        <messages>This is UI button is used to clone the current request.</messages>
        <name>Clone the Request</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function executeAction(current) {
    var gr = new GlideRecord(current.getTableName());
    gr.initialize();

    // --- Manually copy required and important fields ---
    gr.setValue('short_description', current.getValue('short_description'));
    gr.setValue('description', current.getValue('description'));
    gr.setValue('assigned_to', current.getValue('assigned_to'));
    gr.setValue('priority', current.getValue('priority'));
    gr.setValue('state', current.getValue('state'));
    gr.setValue('cmdb_ci', current.getValue('cmdb_ci'));

    // Optional: Mark the short description as a copy
    gr.setValue('short_description', current.getValue('short_description') + ' - Copy');

    // Insert the new record
    var newSysId = gr.insert();

    // Redirect to the new record if insert was successful
    if (newSysId) {
        var newRec = new GlideRecord(current.getTableName());
        if (newRec.get(newSysId)) {
            action.setRedirectURL(newRec);
        }
    } else {
        gs.error("Clone failed: Insert returned null");
    }
})(current);]]></script>
